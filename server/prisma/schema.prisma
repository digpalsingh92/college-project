generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  patient
  doctor
  admin
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  booked
  cancelled
  completed
  no_show
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String   @map("password")
  role          Role     @default(patient)
  age           Int?     // Age for patients
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctorProfile DoctorProfile?
  schedules Schedule[]
  unavailableSlots DoctorUnavailability[]
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[] @relation("DoctorAppointments")
  allocations AppointmentResource[] @relation("PatientAllocations")
}

model DoctorProfile {
  id              String @id @default(uuid())
  userId          String @unique
  specialization  String
  experience      Int
  consultationFee Float

  user User @relation(fields: [userId], references: [id])
}

model Schedule {
  id        String   @id @default(uuid())
  doctorId  String
  dayOfWeek DayOfWeek
  startTime Int   // minutes
  endTime   Int
  slotDurationMinutes Int @default(30)

  doctor User @relation(fields: [doctorId], references: [id])

  @@index([doctorId, dayOfWeek])
  appointments Appointment[]
}

model DoctorUnavailability {
  id        String   @id @default(uuid())
  doctorId  String
  date      DateTime
  startTime Int
  endTime   Int
  reason    String?
  createdAt DateTime @default(now())

  doctor User @relation(fields: [doctorId], references: [id])

  @@index([doctorId, date])
}

model Appointment {
  id         String   @id @default(uuid())
  patientId  String
  doctorId   String
  scheduleId String
  date       DateTime
  startTime  Int
  endTime    Int
  patientAge Int?     // Patient age at time of appointment
  status     AppointmentStatus @default(booked)
  remarks    String?

  // Payment fields
  paymentStatus     String    @default("PENDING") // PENDING, PAID, FAILED, INSURANCE_CLAIMED
  paymentMethod     String?   // CARD, UPI, INSURANCE
  amountPaid        Float     @default(0.0)
  insuranceProvider String?
  insurancePolicy   String?

  createdAt DateTime @default(now())

  patient User @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor  User @relation("DoctorAppointments", fields: [doctorId], references: [id])
  schedule Schedule @relation(fields: [scheduleId], references: [id])
  resources AppointmentResource[]

  @@index([patientId, doctorId, date])
}

enum ResourceCategory {
  BED
  OT
  LAB
  MACHINE
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  OCCUPIED
  VACANT
}

enum OccupancyStatus {
  OCCUPIED
  VACANT
}

model Resource {
  id            String   @id @default(uuid())
  resourceTypeId String

  totalUnits     Int
  availableUnits Int

  status        ResourceStatus @default(ACTIVE)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id])
  appointments AppointmentResource[]
  units        ResourceUnit[]
}

model ResourceType {
  id          String   @id @default(uuid())
  name        String   // ICU Bed, MRI Machine, OT Room, BEDs
  category    ResourceCategory
  basePrice   Float
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resources   Resource[]
}

model ResourceUnit {
  id              String          @id @default(uuid())
  unitNumber      String          // e.g. "BED-001", "MRI-003"
  isActive        Boolean         @default(true)
  occupancyStatus OccupancyStatus @default(VACANT)

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  allocations AppointmentResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resourceId])
}

enum ResourceAllocationStatus {
  ALLOCATED
  RELEASED
  HOLD
}

model AppointmentResource {
  id            String                  @id @default(uuid())
  appointmentId String?
  patientId     String?
  resourceId    String
  resourceUnitId String?
  allocatedFrom DateTime                @default(now())
  allocatedTo   DateTime?
  status        ResourceAllocationStatus @default(ALLOCATED)
  notes         String?

  appointment   Appointment?            @relation(fields: [appointmentId], references: [id])
  patient       User?                   @relation("PatientAllocations", fields: [patientId], references: [id])
  resource      Resource                @relation(fields: [resourceId], references: [id])
  resourceUnit  ResourceUnit?           @relation(fields: [resourceUnitId], references: [id])

  @@index([resourceId, allocatedFrom])
}