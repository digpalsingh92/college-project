# PostgreSQL connection (required). Example for local Postgres:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/YOUR_DB?schema=public"

# Required for signing JWTs on register/login (use a long random string in production)
JWT_SECRET="change-me-to-a-long-random-secret"

# API port (default 4000). Next.js client proxies /api → http://localhost:4000 when BACKEND_URL matches.
PORT=4000
